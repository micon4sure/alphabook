{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alphabook-format:0.3",
  "title": "Alphabook Format — experimental draft 0.3",
  "oneOf": [
    {
      "$ref": "#/$defs/project"
    },
    {
      "$ref": "#/$defs/task"
    },
    {
      "$ref": "#/$defs/decision"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[:\\\\\\u0000-\\u001f])(?!.*(?:^|/)(?:\\.\\.?|\\.git)(?:/|$))(?!.*//)(?!.*/$).+$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "format",
        "format_version",
        "id",
        "name",
        "planning_branch"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "alphabook"
        },
        "format_version": {
          "const": "0.3"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "planning_branch": {
          "const": "alphabook"
        },
        "code_branch": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "title",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "task"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "blocked",
            "review",
            "done",
            "cancelled"
          ]
        },
        "depends_on": {
          "$ref": "#/$defs/ids"
        },
        "decisions": {
          "$ref": "#/$defs/ids"
        },
        "paths": {
          "$ref": "#/$defs/paths"
        },
        "artifacts": {
          "$ref": "#/$defs/paths"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "assignee": {
          "$ref": "#/$defs/text"
        },
        "branches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "commits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "title",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "decision"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "superseded",
            "rejected"
          ]
        },
        "supersedes": {
          "$ref": "#/$defs/id"
        },
        "paths": {
          "$ref": "#/$defs/paths"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
