{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["bun"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
